if BOARD_POCKETBOARD

config ZMK_KEYBOARD_NAME
	default "Pocketboard"

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
	default y

endif # USB

config ZMK_BLE
	default y

config ZMK_USB
	default y

config I2C
	default y

config ZMK_MAX17048
	default y

endif # BOARD_POCKETBOARD
